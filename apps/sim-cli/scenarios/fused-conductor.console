# A melted conductor stays open (ADR 0018, the sticky fused conductor): a save holding a fused conductor
# whose ends were both re-made. A 1.5 m 14 AWG solid THHN conductor screwed across the split-phase
# stand-in's L1 and N (both at the marked 4 N·m) carries kiloamps; its copper reaches the melting point
# within a few tens of ms and it fuses (`fused` set, both ends burned open). A minute later it has
# cooled below the oxidation onset; both ends are then taken off and landed again (new terminations 3
# and 4, D = 1, `ok`), and it stays open: `fused` is sticky, only a new conductor conducts.
# `apps/sim-cli/src/fused-conductor.spec.ts` loads the save written from this file.
#   pnpm sim run apps/sim-cli/scenarios/fused-conductor.console --world content/levels/workshop.json
#   (with --save libs/domain/save-format/fixtures/v4/ctrl/fused-conductor-engine-8-catalog-3.ctrl)
entity.place --ref.id utility.larkmoor-split-phase-25kva --ref.version 1 --positionMm.x 0 --positionMm.y 0 --positionMm.z 0
wire.add --ref.id conductor.tallowmere-thhn-14-solid --ref.version 1 --a.entity 1 --a.terminal l1 --a.termination.method screw --a.termination.strip.tool.id tool.veltmark-ws-1018 --a.termination.strip.tool.version 1 --a.termination.strip.hole sol14 --a.termination.strip.lengthMm 13 --a.termination.accessory null --a.termination.clamp.tool.id tool.calderyn-ts-15 --a.termination.clamp.tool.version 1 --a.termination.clamp.torqueNm 4 --b.entity 1 --b.terminal n --b.termination.method screw --b.termination.strip.tool.id tool.veltmark-ws-1018 --b.termination.strip.tool.version 1 --b.termination.strip.hole sol14 --b.termination.strip.lengthMm 13 --b.termination.accessory null --b.termination.clamp.tool.id tool.calderyn-ts-15 --b.termination.clamp.tool.version 1 --b.termination.clamp.torqueNm 4 --route [{"kind":"free","positionMm":{"x":100,"y":900,"z":200},"entity":null,"fixture":null,"tool":null}] --lengthMm 1500 --colour.base black --colour.stripe null --tool.id tool.veltmark-dc-8 --tool.version 1
sim.step 60000
wire.unland --id 1 --end a
wire.land --id 1 --end a --at.entity 1 --at.terminal l1 --at.termination.method screw --at.termination.strip.tool.id tool.veltmark-ws-1018 --at.termination.strip.tool.version 1 --at.termination.strip.hole sol14 --at.termination.strip.lengthMm 13 --at.termination.accessory null --at.termination.clamp.tool.id tool.calderyn-ts-15 --at.termination.clamp.tool.version 1 --at.termination.clamp.torqueNm 4
wire.unland --id 1 --end b
wire.land --id 1 --end b --at.entity 1 --at.terminal n --at.termination.method screw --at.termination.strip.tool.id tool.veltmark-ws-1018 --at.termination.strip.tool.version 1 --at.termination.strip.hole sol14 --at.termination.strip.lengthMm 13 --at.termination.accessory null --at.termination.clamp.tool.id tool.calderyn-ts-15 --at.termination.clamp.tool.version 1 --at.termination.clamp.torqueNm 4
sim.step 1000
world.hash
