{
  "name": "sim-cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/sim-cli/src",
  "tags": ["type:app", "scope:headless"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["production", "^production"],
      "outputs": ["{workspaceRoot}/dist/apps/sim-cli"],
      "cache": true,
      "options": { "command": "node apps/sim-cli/build.mjs" }
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/apps/*/project.json",
        "{workspaceRoot}/libs/**/project.json"
      ]
    },
    "bench": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": false,
      "options": { "command": "node dist/apps/sim-cli/main.mjs bench" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": { "command": "tsc -p apps/sim-cli/tsconfig.app.json && tsc -p apps/sim-cli/tsconfig.spec.json" }
    }
  }
}
