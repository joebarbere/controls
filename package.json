{
  "name": "controls",
  "version": "0.2.0",
  "description": "Controls — a realistic electrician to controls-engineer simulation game.",
  "author": "Joe Barbere",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/joebarbere/controls.git"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.28.8",
  "scripts": {
    "verify": "prettier --check . && nx run-many -t lint typecheck test build && node tools/check-version-sync.mjs",
    "format": "prettier --write .",
    "start": "nx run desktop:start",
    "start:web": "nx serve game",
    "test": "nx run-many -t test",
    "e2e": "nx run game-e2e:e2e",
    "e2e:desktop": "nx run desktop-e2e:e2e",
    "build:desktop": "nx run desktop:build",
    "package:desktop": "nx run desktop:package",
    "package:desktop:dir": "nx run desktop:package-dir",
    "version:sync": "node tools/sync-version.mjs",
    "sim": "node apps/sim-cli/bin/sim.mjs"
  },
  "dependencies": {
    "@angular/common": "~22.2.0",
    "@angular/compiler": "~22.2.0",
    "@angular/core": "~22.2.0",
    "@angular/forms": "~22.2.0",
    "@angular/platform-browser": "~22.2.0",
    "@angular/router": "~22.2.0",
    "@codemirror/state": "~6.7.6",
    "@codemirror/view": "~6.43.15",
    "fflate": "~0.8.3",
    "rxjs": "~7.8.0",
    "three": "0.186.1",
    "three-mesh-bvh": "~0.9.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angular-devkit/core": "~22.2.0",
    "@angular-devkit/schematics": "~22.2.0",
    "@angular/build": "~22.2.0",
    "@angular/cli": "~22.2.0",
    "@angular/compiler-cli": "~22.2.0",
    "@angular/language-service": "~22.2.0",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "24.0.2",
    "@nx/devkit": "24.0.2",
    "@nx/eslint": "24.0.2",
    "@nx/eslint-plugin": "24.0.2",
    "@nx/js": "24.0.2",
    "@nx/playwright": "24.0.2",
    "@nx/vitest": "24.0.2",
    "@nx/web": "24.0.2",
    "@playwright/test": "^1.64.1",
    "@schematics/angular": "~22.2.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/three": "0.186.0",
    "@typescript-eslint/utils": "^8.58.0",
    "@vitest/coverage-v8": "^4.0.0",
    "angular-eslint": "^22.5.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.1",
    "electron-updater": "6.8.12",
    "esbuild": "0.28.2",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "fast-check": "^4.10.2",
    "jsdom": "^27.1.0",
    "nx": "24.0.2",
    "prettier": "^3.8.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "vitest": "~4.1.12"
  }
}
