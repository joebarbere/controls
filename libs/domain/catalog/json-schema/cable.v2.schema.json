{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "brand": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "modelName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "conductors": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "conductor": {
            "$ref": "#/$defs/CatalogRef"
          },
          "role": {
            "type": "string",
            "enum": [
              "ungrounded",
              "grounded",
              "egc"
            ]
          },
          "insulated": {
            "type": "boolean"
          },
          "colour": {
            "type": "object",
            "properties": {
              "base": {
                "$ref": "#/$defs/ColourId"
              },
              "stripe": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ColourId"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "base",
              "stripe"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "index",
          "conductor",
          "role",
          "insulated",
          "colour"
        ],
        "additionalProperties": false
      }
    },
    "jacket": {
      "type": "object",
      "properties": {
        "material": {
          "$ref": "#/$defs/TableRef"
        },
        "colour": {
          "$ref": "#/$defs/ColourId"
        },
        "thicknessMm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "widthMm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "heightMm": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "material",
        "colour",
        "thicknessMm",
        "widthMm",
        "heightMm"
      ],
      "additionalProperties": false
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "real-world",
              "game-design"
            ]
          },
          "citation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "covers": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 120,
              "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_-]*)(?:\\.(?:(?:[A-Za-z0-9][A-Za-z0-9_-]*)|\\*))*$"
            }
          }
        },
        "required": [
          "id",
          "kind",
          "citation",
          "covers"
        ],
        "additionalProperties": false
      }
    },
    "extensions": {
      "$ref": "#/$defs/Extensions"
    }
  },
  "required": [
    "id",
    "version",
    "title",
    "brand",
    "modelName",
    "conductors",
    "jacket",
    "sources",
    "extensions"
  ],
  "additionalProperties": false,
  "title": "Controls cable assembly, catalogue format v2",
  "description": "One file in content/cables/ (ADR 0016). Zod in @controls/catalog is authoritative; conductor refs, colours, table refs and source coverage are checked by parseCatalog.",
  "$defs": {
    "CatalogRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)+$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false,
      "description": "A catalogue entry by reference: id plus integer version."
    },
    "ColourId": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[a-z][a-zA-Z0-9]{0,31}$",
      "description": "A row of the catalogue colour table: lower camelCase, at most 32."
    },
    "TableRef": {
      "type": "object",
      "properties": {
        "table": {
          "$ref": "#/$defs/TableName"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "key": {
          "$ref": "#/$defs/TableKey"
        }
      },
      "required": [
        "table",
        "version",
        "key"
      ],
      "additionalProperties": false,
      "description": "A pinned catalogue table row: { table, version, key }."
    },
    "TableName": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[a-z][a-zA-Z0-9]{0,31}$",
      "description": "A catalogue table name: lower camelCase."
    },
    "TableKey": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[a-z][a-zA-Z0-9]{0,31}$",
      "description": "A row key of a catalogue table: lower camelCase."
    },
    "Extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "description": "Forward-compatibility bag: opaque JSON that every version must round-trip untouched."
    },
    "JsonValue": {
      "description": "Any JSON value: finite numbers only, well-formed strings; loaders also refuse \"__proto__\" keys.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    }
  }
}
