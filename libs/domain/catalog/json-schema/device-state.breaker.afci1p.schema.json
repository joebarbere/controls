{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "state": {
      "type": "object",
      "properties": {
        "on": {
          "type": "boolean"
        },
        "test": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "on",
        "test"
      ],
      "additionalProperties": false
    },
    "sim": {
      "type": "object",
      "properties": {
        "arcExposure": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "arcLastSeenTick": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "magneticSinceTick": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "thermal": {
          "type": "number",
          "minimum": 0
        },
        "tripCause": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "thermal",
                "magnetic",
                "groundFault",
                "arcFault",
                "test"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "tripped": {
          "type": "boolean"
        }
      },
      "required": [
        "arcExposure",
        "arcLastSeenTick",
        "magneticSinceTick",
        "thermal",
        "tripCause",
        "tripped"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "state",
    "sim"
  ],
  "additionalProperties": false,
  "title": "Device state of model kind breaker.afci1p",
  "description": "EntityV2.state (commanded) and EntityV2.sim (sim-owned) of a breaker.afci1p device (ADR 0011, ADR 0013). Every key is present; null means absent."
}
