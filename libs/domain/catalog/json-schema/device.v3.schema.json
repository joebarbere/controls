  "required": [
    "id",
    "version",
    "title",
    "brand",
    "modelName",
    "category",
    "sizeMm",
    "terminals",
    "mounts",
    "enclosure",
    "hostMounts",
    "outlets",
    "plug",
    "supersededBy",
    "conductor",
    "model",
    "controls",
    "sources",
    "extensions"
  ],
  "additionalProperties": false,
  "title": "Controls device catalogue entry, catalogue format v3",
  "description": "One file in content/devices/ (ADR 0013, ADR 0016, ADR 0020). Zod in @controls/catalog is authoritative; this JSON Schema omits the rules that depend on the model kind (parameters, terminals, controls), the registries (methods, mount, entry and host-contact types, NEMA configurations), the tables, and source coverage.",
  "$defs": {
    "TerminalId": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$",
      "description": "A terminal id within one device: a letter or digit, then letters, digits, \"_\" or \"-\"; at most 32."
    },
    "TerminationMethodId": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[a-z][a-zA-Z0-9]{0,31}$",
      "description": "A termination method id: lower camelCase."
    },
    "Awg": {
      "type": "integer",
      "minimum": -3,
      "maximum": 40,
      "description": "An AWG size as an integer designation: 4/0 = -3, 3/0 = -2, 2/0 = -1, 1/0 = 0, then 1 to 40."
    },
    "ContactId": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[a-z][a-zA-Z0-9]{0,31}$",
      "description": "A mount contact id: lower camelCase, at most 32 characters."
    },
    "MountId": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$",
      "description": "A mount id within one catalogue entry (TerminalId grammar)."
    },
    "EntryId": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$",
      "description": "An enclosure entry id within one catalogue entry."
    },
    "OutletId": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$",
      "description": "A receptacle outlet id within one catalogue entry (TerminalId grammar)."
    },
    "NemaConfigId": {
      "type": "string",
      "maxLength": 16,
      "pattern": "^L?\\d{1,2}-\\d{2,3}[PR]$",
      "description": "A NEMA wiring-device configuration: a row of NEMA_CONFIGS."
    },
    "PinId": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[a-z][a-zA-Z0-9]{0,31}$",
      "description": "A blade or slot of a NEMA configuration: lower camelCase."
    },
    "CatalogRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)+$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false,
      "description": "A catalogue entry by reference: id plus integer version."
    },
    "TableRef": {
      "type": "object",
      "properties": {
        "table": {
          "$ref": "#/$defs/TableName"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "key": {
          "$ref": "#/$defs/TableKey"
        }
      },
      "required": [
        "table",
        "version",
        "key"
      ],
      "additionalProperties": false,
      "description": "A pinned catalogue table row: { table, version, key }."
    },
    "TableName": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[a-z][a-zA-Z0-9]{0,31}$",
      "description": "A catalogue table name: lower camelCase."
    },
    "TableKey": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[a-z][a-zA-Z0-9]{0,31}$",
      "description": "A row key of a catalogue table: lower camelCase."
    },
    "ColourId": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[a-z][a-zA-Z0-9]{0,31}$",
      "description": "A row of the catalogue colour table: lower camelCase, at most 32."
    },
    "Extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "description": "Forward-compatibility bag: opaque JSON that every version must round-trip untouched."
    },
    "JsonValue": {
      "description": "Any JSON value: finite numbers only, well-formed strings; loaders also refuse \"__proto__\" keys.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    }
  }
}
