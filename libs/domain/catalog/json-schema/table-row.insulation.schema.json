{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "material": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "ratedTempDryK": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "ratedTempWetK": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "thermalConductivityWPerMK": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "jacketThermalConductivityWPerMK": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "emissivity": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "name",
    "material",
    "ratedTempDryK",
    "ratedTempWetK",
    "thermalConductivityWPerMK",
    "jacketThermalConductivityWPerMK",
    "emissivity"
  ],
  "additionalProperties": false,
  "title": "Row of catalogue table insulation",
  "description": "Conductor insulation types and cable jackets: temperature ratings and thermal properties."
}
