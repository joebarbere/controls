{
  "name": "catalog",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/domain/catalog/src",
  "projectType": "library",
  "tags": ["type:domain"],
  "targets": {
    "test": {
      "inputs": [
        "default",
        "^production",
        { "fileset": "{projectRoot}/tsconfig.spec.json", "dependencies": true },
        { "json": "{workspaceRoot}/libs/domain/tsconfig.domain.json", "fields": ["compilerOptions"] },
        { "externalDependencies": ["vitest"] },
        { "env": "CI" },
        { "dependentTasksOutputFiles": "**/*.js", "transitive": true },
        "{workspaceRoot}/CHANGELOG.md"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "command": "tsc -p libs/domain/catalog/tsconfig.lib.json --noEmit && tsc -p libs/domain/catalog/tsconfig.spec.json --noEmit"
      }
    }
  }
}
