{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ref": {
      "description": "A cable assembly in the catalogue (cable.…)",
      "title": "Cable",
      "$ref": "#/$defs/CatalogRef"
    },
    "a": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "entity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "x-controls-ref": "entity",
              "title": "Enclosure"
            },
            "entry": {
              "description": "An entry id of the enclosure's catalogue entry (ko1, top)",
              "title": "Entry",
              "$ref": "#/$defs/EntryId"
            }
          },
          "required": [
            "entity",
            "entry"
          ],
          "additionalProperties": false,
          "title": "Entry"
        },
        {
          "type": "null"
        }
      ],
      "title": "End a"
    },
    "b": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "entity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "x-controls-ref": "entity",
              "title": "Enclosure"
            },
            "entry": {
              "description": "An entry id of the enclosure's catalogue entry (ko1, top)",
              "title": "Entry",
              "$ref": "#/$defs/EntryId"
            }
          },
          "required": [
            "entity",
            "entry"
          ],
          "additionalProperties": false,
          "title": "Entry"
        },
        {
          "type": "null"
        }
      ],
      "title": "End b"
    },
    "route": {
      "maxItems": 1024,
      "type": "array",
      "items": {
        "title": "Waypoint",
        "$ref": "#/$defs/WaypointV3"
      },
      "title": "Route"
    },
    "lengthMm": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000,
      "title": "Length (mm)"
    },
    "tailsMm": {
      "type": "object",
      "properties": {
        "a": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000,
          "title": "End a"
        },
        "b": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000,
          "title": "End b"
        }
      },
      "required": [
        "a",
        "b"
      ],
      "additionalProperties": false,
      "title": "Tails (mm)"
    },
    "tool": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)+$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false,
      "description": "A tool in the catalogue (tool.…)",
      "title": "Cutter",
      "$ref": "#/$defs/CatalogRef"
    }
  },
  "required": [
    "ref",
    "a",
    "b",
    "route",
    "lengthMm",
    "tailsMm",
    "tool"
  ],
  "additionalProperties": false,
  "$defs": {
    "CatalogRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)+$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false,
      "description": "A catalogue entry by reference: id plus integer version."
    },
    "EntryId": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$",
      "description": "An enclosure entry id within one catalogue entry."
    },
    "PositionMmV1": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "y": {
          "type": "integer",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "z": {
          "type": "integer",
          "minimum": -10000000,
          "maximum": 10000000
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "additionalProperties": false,
      "description": "Integer millimetres, right-handed, +y up."
    },
    "FixtureIdV1": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "description": "Lower-case words joined by single hyphens, at most 64 characters."
    },
    "WaypointV3": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "free",
            "duct",
            "conduit",
            "staple",
            "bore"
          ]
        },
        "positionMm": {
          "$ref": "#/$defs/PositionMmV1"
        },
        "entity": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "fixture": {
          "anyOf": [
            {
              "$ref": "#/$defs/FixtureIdV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "tool": {
          "anyOf": [
            {
              "$ref": "#/$defs/CatalogRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "positionMm",
        "entity",
        "fixture",
        "tool"
      ],
      "additionalProperties": false
    }
  },
  "title": "Arguments of cable.add"
}
