{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "x-controls-ref": "entity",
      "title": "Entity"
    },
    "positionMm": {
      "$ref": "#/$defs/PositionMmV1"
    }
  },
  "required": [
    "id",
    "positionMm"
  ],
  "additionalProperties": false,
  "$defs": {
    "PositionMmV1": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "y": {
          "type": "integer",
          "minimum": -10000000,
          "maximum": 10000000
        },
        "z": {
          "type": "integer",
          "minimum": -10000000,
          "maximum": 10000000
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "additionalProperties": false,
      "description": "Integer millimetres, right-handed, +y up."
    }
  },
  "title": "Arguments of entity.move"
}
